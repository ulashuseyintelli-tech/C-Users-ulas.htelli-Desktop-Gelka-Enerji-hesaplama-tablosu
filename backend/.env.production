# Gelka Enerji API - Production / Desktop
# GÜVENLİK: Bu dosya installer'a paketlenir. SECRET KOYMAYIN.
# OpenAI API key ve diğer secret'lar ORTAM DEĞİŞKENİ olarak set edilmelidir.

# PDSMR-R3B (STEP 5) düzeltmesi: "staging" YANILTICIYDI (owner: bu bir
# dev/test ortamı DEĞİL) — ama düz "production" da YAPILAMAZ:
# incident_service.py'nin check_production_guard()'ı ENV="production"
# gördüğünde ADMIN_API_KEY_ENABLED + 32+ karakterlik ADMIN_API_KEY ZORUNLU
# kılar (şu an API_KEY_ENABLED=false aşağıda); bu key, YALNIZ "admin"
# uçlarını değil, require_api_key() KULLANAN 21 endpoint'in TAMAMINI
# (fatura/teklif/PDF ana API yüzeyi) etkiler ve frontend/Electron IPC'si
# HENÜZ bu key'i göndermeyi bilmiyor — bu, paketlenmiş uygulamanın
# başlangıcını KIRAR (gerçek koddan doğrulandı) VE "dar kapsamlı build
# yapılandırması"nın AÇIKÇA DIŞINDA, AYRI bir güvenlik/UX değişikliği
# gerektirir (owner kararıyla PDSMR-R3B'de bilinçli olarak ERTELENDİ).
#
# "desktop": VALID_ENVIRONMENTS içinde (incident_service.py), paketlenmiş
# masaüstü uygulamasının GERÇEK/DÜRÜST değeri — dev/test ortamı OLMADIĞINI
# doğru yansıtır AMA check_production_guard() yalnız LİTERAL "production"
# için katı kuralı tetiklediğinden hiçbir davranış değişikliğine yol AÇMAZ.
#
# Paketlenmiş/paketlenmemiş ayrımının GERÇEK, tekil sinyali GELKA_PACKAGED_RUNTIME
# (electron/main.js tarafından enjekte edilir, machine-local.env tarafından
# EZİLEMEZ — bkz. database.py::init_db()). Frozen run_server.py AYRICA,
# Electron'dan BAĞIMSIZ olarak hem GELKA_PACKAGED_RUNTIME=1 hem ENV=desktop'ın
# GERÇEKTEN (gerçek ortam değişkeni olarak, bu dosyadan DEĞİL) set edildiğini
# doğrular — bkz. run_server.py::_enforce_packaged_environment_invariants
# (PDSMR-R3B STEP 5: "direct packaged-backend launch without these invariants
# fails closed").
ENV=desktop

# Database (SQLite for desktop)
DATABASE_URL=sqlite:///./gelka_enerji.db

# OpenAI — ORTAM DEĞİŞKENİ OLARAK SET EDİN:
#   set OPENAI_API_KEY=sk-...
# Bu dosyaya API key YAZMAYIN.
OPENAI_MODEL=gpt-4o

# API Auth
API_KEY_ENABLED=false

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Worker
WORKER_POLL_INTERVAL=1.0

# Cache
EXTRACTION_CACHE_ENABLED=true

# Prompt Version
EXTRACTION_PROMPT_VERSION=v3

# Rate Limiting
RATE_LIMIT_ENABLED=false

# Multi-tenant
TENANT_REQUIRED=false
DEFAULT_TENANT=default

# ═══════════════════════════════════════════════════════════════════════════════
# EPİAŞ Şeffaflık Platformu API
# ═══════════════════════════════════════════════════════════════════════════════
EPIAS_USERNAME=
EPIAS_PASSWORD=

# NOT (bu turda düzeltildi): OPENAI_API_KEY buraya YAZILMAZ — bu dosya installer'a
# paketlenir, gerçek secret installer artifact'ına gömülmemeli. Packaged runtime
# anahtarı machine-local external config'ten alır:
#   %APPDATA%\gelka-enerji\machine-local.env  (electron/main.js loadMachineLocalEnv)
# Bu dosya kurulumdan kurulumu HAYATTA KALIR (userData, resources/ değil) ve asla
# installer içine paketlenmez. Dev ortamında normal backend/.env yeterlidir.
