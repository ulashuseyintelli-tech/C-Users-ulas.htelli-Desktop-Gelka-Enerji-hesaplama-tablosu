# Gelka Enerji API - Production / Desktop
# GÜVENLİK: Bu dosya installer'a paketlenir. SECRET KOYMAYIN.
# OpenAI API key ve diğer secret'lar ORTAM DEĞİŞKENİ olarak set edilmelidir.

ENV=development

# Database (SQLite for desktop)
DATABASE_URL=sqlite:///./gelka_enerji.db

# OpenAI — ORTAM DEĞİŞKENİ OLARAK SET EDİN:
#   set OPENAI_API_KEY=sk-...
# Bu dosyaya API key YAZMAYIN.
OPENAI_MODEL=gpt-4o

# API Auth
API_KEY_ENABLED=false

# Storage
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Worker
WORKER_POLL_INTERVAL=1.0

# Cache
EXTRACTION_CACHE_ENABLED=true

# Prompt Version
EXTRACTION_PROMPT_VERSION=v3

# Rate Limiting
RATE_LIMIT_ENABLED=false

# Multi-tenant
TENANT_REQUIRED=false
DEFAULT_TENANT=default

# ═══════════════════════════════════════════════════════════════════════════════
# EPİAŞ Şeffaflık Platformu API
# ═══════════════════════════════════════════════════════════════════════════════
EPIAS_USERNAME=
EPIAS_PASSWORD=

# NOT (bu turda düzeltildi): OPENAI_API_KEY buraya YAZILMAZ — bu dosya installer'a
# paketlenir, gerçek secret installer artifact'ına gömülmemeli. Packaged runtime
# anahtarı machine-local external config'ten alır:
#   %APPDATA%\gelka-enerji\machine-local.env  (electron/main.js loadMachineLocalEnv)
# Bu dosya kurulumdan kurulumu HAYATTA KALIR (userData, resources/ değil) ve asla
# installer içine paketlenmez. Dev ortamında normal backend/.env yeterlidir.
