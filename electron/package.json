{
  "name": "gelka-enerji",
  "version": "1.0.12",
  "description": "Gelka Enerji - Fatura Analiz ve Teklif Sistemi",
  "main": "main.js",
  "author": "Gelka Enerji",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:frontend": "cd ../frontend && npm run build",
    "build:backend": "cd ../backend && pyinstaller --onefile --name gelka-backend --add-data \"app;app\" --hidden-import uvicorn.logging --hidden-import uvicorn.protocols.http --hidden-import uvicorn.protocols.http.auto --hidden-import uvicorn.protocols.websockets --hidden-import uvicorn.protocols.websockets.auto --hidden-import uvicorn.lifespan --hidden-import uvicorn.lifespan.on --hidden-import logging.config --collect-all alembic run_server.py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.gelkaenerji.app",
    "productName": "Gelka Enerji",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../backend/dist/gelka-backend.exe",
        "to": "backend/gelka-backend.exe"
      },
      {
        "from": "../backend/.env.production",
        "to": "backend/.env"
      },
      {
        "from": "../backend/build-info.json",
        "to": "backend/build-info.json"
      },
      {
        "from": "../backend/alembic.ini",
        "to": "backend/alembic.ini"
      },
      {
        "from": "../backend/alembic",
        "to": "backend/alembic",
        "filter": [
          "**/*",
          "!__pycache__",
          "!__pycache__/**"
        ]
      }
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "signDlls": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gelka Enerji",
      "deleteAppDataOnUninstall": false,
      "menuCategory": "Gelka Enerji",
      "artifactName": "Gelka-Enerji-Setup.${ext}",
      "include": "build/installer.nsh"
    }
  }
}
